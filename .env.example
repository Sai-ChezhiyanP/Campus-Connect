# ==========================================
# Campus Connect — Environment Variables
# ==========================================

# Supabase Public Configuration (Mobile & Web)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Secret Configuration (Server-Side edge functions / web api routes ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Institution Domain Constraint
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=srmist.edu.in
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=srmist.edu.in
